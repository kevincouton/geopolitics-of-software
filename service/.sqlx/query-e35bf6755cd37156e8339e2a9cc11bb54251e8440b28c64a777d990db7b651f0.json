{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT p.*, COALESCE(ds.asia_readiness_score, NULL) AS score\n        FROM projects p\n        LEFT JOIN LATERAL (\n            SELECT asia_readiness_score\n            FROM daily_snapshots\n            WHERE project_id = p.id\n            ORDER BY snapshot_date DESC\n            LIMIT 1\n        ) ds ON true\n        ORDER BY p.stars DESC\n        LIMIT $1 OFFSET $2\n        ",
