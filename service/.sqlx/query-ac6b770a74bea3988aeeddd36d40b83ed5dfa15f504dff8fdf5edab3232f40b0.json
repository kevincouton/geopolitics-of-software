{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT p.id, p.github_owner, p.github_name, p.gitee_owner, p.gitee_name, p.language,\n               p.topics, p.description, p.stars, p.forks, p.open_issues,\n               p.has_chinese_readme, p.has_gitee_mirror,\n               COALESCE(ds.asia_readiness_score, NULL) AS score, t.created_at AS tracked_at\n        FROM tracked_projects t\n        JOIN projects p ON p.id = t.project_id\n        LEFT JOIN LATERAL (\n            SELECT asia_readiness_score\n            FROM daily_snapshots\n            WHERE project_id = p.id\n            ORDER BY snapshot_date DESC\n            LIMIT 1\n        ) ds ON true\n        WHERE t.user_id = $1\n        ORDER BY t.created_at DESC\n        ",
